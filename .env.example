# Copy to .env and fill in values for this environment (staging or prod)

ENVIRONMENT=staging   # or: prod

# Firebase Admin SDK — scanner.py (VM only)
FIREBASE_CRED=/home/scanner/firebase_cred.json
FIREBASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com

# Firebase Web SDK — app.py (Vercel)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_APP_ID=

