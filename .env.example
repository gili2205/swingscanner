# Copy to .env and fill in — staging and prod each have their own values

ENVIRONMENT=staging   # or: prod

# Firebase Admin SDK (scanner.py — VM only)
FIREBASE_CRED=/home/scanner/firebase_cred.json
FIREBASE_URL=https://YOUR_PROJECT-default-rtdb.firebaseio.com

# Firebase Web SDK (app.py — Vercel)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
FIREBASE_PROJECT_ID=YOUR_PROJECT
FIREBASE_APP_ID=

# Alpaca (market data)
ALPACA_KEY=PKGXMB7OCNTGBJ2JFLDUJFZJ76
ALPACA_SECRET=

# Finnhub (sentiment — optional)
FINNHUB_KEY=
